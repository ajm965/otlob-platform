{
  "name": "otlob-platform",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "otlob-platform",
      "version": "0.1.0",
      "workspaces": [
        "packages/core",
        "backend"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "backend": {
      "name": "@otlob/backend",
      "version": "0.1.0",
      "dependencies": {
        "@otlob/core": "file:../packages/core"
      },
      "devDependencies": {
        "typescript": "^5.6.3"
      }
    },
    "node_modules/@otlob/backend": {
      "resolved": "backend",
      "link": true
    },
    "node_modules/@otlob/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/core": {
      "name": "@otlob/core",
      "version": "0.1.0",
      "devDependencies": {
        "typescript": "^5.6.3"
      }
    }
  }
}
