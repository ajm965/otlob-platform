# Environment template for Cloud Functions (no secrets).
# Copy to backend/functions/.env for emulator/local use. Do not commit .env.

# development | staging | production
OTLB_ENV=development

# debug | info | warn | error | critical
OTLB_LOG_LEVEL=info

OTLB_SERVICE_NAME=otlob-platform-api
OTLB_SERVICE_VERSION=0.1.0

# Firebase Functions region
OTLB_FUNCTION_REGION=europe-west1

# Required outside Cloud Functions. Inside Functions, GCLOUD_PROJECT / FIREBASE_CONFIG is used.
FIREBASE_PROJECT_ID=otlob-dev
