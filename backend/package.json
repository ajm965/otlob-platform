{
  "name": "@otlob/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Otlob backend workspace — domain foundation (Sprint 2.3)",
  "main": "dist/catalog-index.js",
  "types": "dist/catalog-index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:domain": "tsc -p tsconfig.domain.json",
